{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "date-night",
  "main": "worker/production.ts",
  "account_id": "e3d08b2d5d75c95b3ab6877e973df064",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "LOCAL_DEV": "false",
    "APP_ORIGIN": "https://date-night.onbuyuka.workers.dev",
    "WEB_READER_ORIGIN": "https://date-night-reader.onrender.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "date-night-production",
      "database_id": "b9b31d6c-8752-474d-8a6e-93f5f2afb48b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
